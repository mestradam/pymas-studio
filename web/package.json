{
  "name": "pymas-studio-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PyMAS Studio 3D - visor estático de modelos estructurales PyMAS",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync-samples.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/sync-samples.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples:sync": "node scripts/sync-samples.mjs",
    "build:python": "node scripts/sync-python-static.mjs",
    "package:python": "npm run build && npm run build:python",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
